{
  "$defs": {
    "DataPartition": {
      "enum": [
        "train",
        "evaluator-development",
        "promotion-same-family",
        "promotion-unseen-family",
        "public-audit",
        "quarantine"
      ],
      "title": "DataPartition",
      "type": "string"
    },
    "DraftDataManifest": {
      "additionalProperties": false,
      "properties": {
        "duplicate_check_version": {
          "title": "Duplicate Check Version",
          "type": "string"
        },
        "license_policy_version": {
          "title": "License Policy Version",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "sealed_sources": {
          "items": {
            "type": "string"
          },
          "title": "Sealed Sources",
          "type": "array"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "split_ratios": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/DataPartition"
          },
          "title": "Split Ratios",
          "type": "object"
        }
      },
      "required": [
        "source",
        "revision",
        "split_ratios",
        "license_policy_version",
        "duplicate_check_version",
        "sealed_sources"
      ],
      "title": "DraftDataManifest",
      "type": "object"
    },
    "DraftModelRef": {
      "additionalProperties": false,
      "properties": {
        "expected_precision": {
          "title": "Expected Precision",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision",
        "expected_precision"
      ],
      "title": "DraftModelRef",
      "type": "object"
    },
    "DraftRuntimeRef": {
      "additionalProperties": false,
      "properties": {
        "requested_hardware": {
          "$ref": "#/$defs/HardwareRequest"
        },
        "sglang_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Sglang Revision",
          "type": "string"
        },
        "specforge_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Specforge Revision",
          "type": "string"
        }
      },
      "required": [
        "sglang_revision",
        "specforge_revision",
        "requested_hardware"
      ],
      "title": "DraftRuntimeRef",
      "type": "object"
    },
    "EvaluatorBundle": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanApproval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "binary_check_versions": {
          "items": {
            "type": "string"
          },
          "title": "Binary Check Versions",
          "type": "array"
        },
        "coverage_floors": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Coverage Floors",
          "type": "object"
        },
        "judge_prompt_versions": {
          "items": {
            "type": "string"
          },
          "title": "Judge Prompt Versions",
          "type": "array"
        },
        "physical_test_version": {
          "title": "Physical Test Version",
          "type": "string"
        },
        "promotion_limits": {
          "$ref": "#/$defs/PromotionLimits"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "workload_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Workload Weights",
          "type": "object"
        }
      },
      "required": [
        "version",
        "binary_check_versions",
        "judge_prompt_versions",
        "physical_test_version",
        "workload_weights",
        "promotion_limits",
        "coverage_floors"
      ],
      "title": "EvaluatorBundle",
      "type": "object"
    },
    "HardwareRequest": {
      "additionalProperties": false,
      "properties": {
        "allow_substitution": {
          "const": false,
          "default": false,
          "title": "Allow Substitution",
          "type": "boolean"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "gpu": {
          "enum": [
            "H100",
            "L40S",
            "B200"
          ],
          "title": "Gpu",
          "type": "string"
        },
        "memory_gib_minimum": {
          "minimum": 1,
          "title": "Memory Gib Minimum",
          "type": "integer"
        },
        "provider": {
          "const": "modal",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "gpu",
        "count",
        "memory_gib_minimum"
      ],
      "title": "HardwareRequest",
      "type": "object"
    },
    "HumanApproval": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ssh-ed25519",
          "default": "ssh-ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Hash",
          "type": "string"
        },
        "public_key": {
          "title": "Public Key",
          "type": "string"
        },
        "signature": {
          "title": "Signature",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer": {
          "title": "Signer",
          "type": "string"
        }
      },
      "required": [
        "payload_hash",
        "signature",
        "public_key",
        "signer",
        "signed_at"
      ],
      "title": "HumanApproval",
      "type": "object"
    },
    "PromotionLimits": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_resamples": {
          "default": 10000,
          "minimum": 100,
          "title": "Bootstrap Resamples",
          "type": "integer"
        },
        "bootstrap_seed": {
          "default": 20260812,
          "title": "Bootstrap Seed",
          "type": "integer"
        },
        "cold_loads_required": {
          "default": 3,
          "minimum": 1,
          "title": "Cold Loads Required",
          "type": "integer"
        },
        "matched_requests_per_arm": {
          "default": 256,
          "minimum": 1,
          "title": "Matched Requests Per Arm",
          "type": "integer"
        },
        "output_rate_lcb_minimum": {
          "default": 0.03,
          "title": "Output Rate Lcb Minimum",
          "type": "number"
        },
        "p95_latency_upper_regression_maximum": {
          "default": 0.01,
          "title": "P95 Latency Upper Regression Maximum",
          "type": "number"
        },
        "p99_latency_upper_regression_maximum": {
          "default": 0.02,
          "title": "P99 Latency Upper Regression Maximum",
          "type": "number"
        },
        "required_concurrencies": {
          "default": [
            1,
            4
          ],
          "items": {
            "type": "integer"
          },
          "title": "Required Concurrencies",
          "type": "array"
        }
      },
      "title": "PromotionLimits",
      "type": "object"
    },
    "StopRules": {
      "additionalProperties": false,
      "properties": {
        "maximum_updates": {
          "minimum": 1,
          "title": "Maximum Updates",
          "type": "integer"
        },
        "stop_on_artifact_failure": {
          "default": true,
          "title": "Stop On Artifact Failure",
          "type": "boolean"
        },
        "stop_on_missing_observability": {
          "default": true,
          "title": "Stop On Missing Observability",
          "type": "boolean"
        },
        "stop_on_parity_mismatch": {
          "default": true,
          "title": "Stop On Parity Mismatch",
          "type": "boolean"
        }
      },
      "required": [
        "maximum_updates"
      ],
      "title": "StopRules",
      "type": "object"
    },
    "TrainingRule": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "learning_rate": {
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "type": "number"
        },
        "loss_selection": {
          "const": "all_positions",
          "default": "all_positions",
          "title": "Loss Selection",
          "type": "string"
        },
        "maximum_policy_lag": {
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Policy Lag",
          "type": "integer"
        },
        "mode": {
          "const": "online_dflash",
          "title": "Mode",
          "type": "string"
        },
        "trainer": {
          "const": "specforge",
          "title": "Trainer",
          "type": "string"
        },
        "update_every_traces": {
          "minimum": 1,
          "title": "Update Every Traces",
          "type": "integer"
        }
      },
      "required": [
        "trainer",
        "mode",
        "learning_rate",
        "batch_size",
        "update_every_traces",
        "maximum_policy_lag"
      ],
      "title": "TrainingRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/DraftDataManifest"
    },
    "drafter": {
      "$ref": "#/$defs/DraftModelRef"
    },
    "evaluator": {
      "$ref": "#/$defs/EvaluatorBundle"
    },
    "initial_mode": {
      "const": "off",
      "default": "off",
      "title": "Initial Mode",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/DraftRuntimeRef"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "seeds": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Seeds",
      "type": "object"
    },
    "stop_rules": {
      "$ref": "#/$defs/StopRules"
    },
    "target": {
      "$ref": "#/$defs/DraftModelRef"
    },
    "training": {
      "$ref": "#/$defs/TrainingRule"
    }
  },
  "required": [
    "schema_version",
    "name",
    "target",
    "drafter",
    "training",
    "runtime",
    "data",
    "evaluator",
    "seeds",
    "stop_rules"
  ],
  "title": "ExperimentDraft",
  "type": "object"
}
