{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "storage_path": {
          "title": "Storage Path",
          "type": "string"
        },
        "validation_result": {
          "enum": [
            "pending",
            "valid",
            "invalid"
          ],
          "title": "Validation Result",
          "type": "string"
        }
      },
      "required": [
        "content_hash",
        "size",
        "storage_path",
        "producer",
        "validation_result"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "DataManifest": {
      "additionalProperties": false,
      "properties": {
        "approved_row_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Approved Row Ids",
          "type": "array"
        },
        "duplicate_check_version": {
          "title": "Duplicate Check Version",
          "type": "string"
        },
        "exclusions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Exclusions",
          "type": "object"
        },
        "license_policy_version": {
          "title": "License Policy Version",
          "type": "string"
        },
        "partitions": {
          "items": {
            "$ref": "#/$defs/PartitionMembership"
          },
          "title": "Partitions",
          "type": "array"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "sealed_sources": {
          "items": {
            "$ref": "#/$defs/SealedSourceRef"
          },
          "title": "Sealed Sources",
          "type": "array"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "revision",
        "approved_row_ids",
        "exclusions",
        "partitions",
        "license_policy_version",
        "duplicate_check_version",
        "sealed_sources"
      ],
      "title": "DataManifest",
      "type": "object"
    },
    "DataPartition": {
      "enum": [
        "train",
        "evaluator-development",
        "promotion-same-family",
        "promotion-unseen-family",
        "public-audit",
        "quarantine"
      ],
      "title": "DataPartition",
      "type": "string"
    },
    "EvaluatorBundle": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanApproval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "binary_check_versions": {
          "items": {
            "type": "string"
          },
          "title": "Binary Check Versions",
          "type": "array"
        },
        "coverage_floors": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Coverage Floors",
          "type": "object"
        },
        "judge_prompt_versions": {
          "items": {
            "type": "string"
          },
          "title": "Judge Prompt Versions",
          "type": "array"
        },
        "physical_test_version": {
          "title": "Physical Test Version",
          "type": "string"
        },
        "promotion_limits": {
          "$ref": "#/$defs/PromotionLimits"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "workload_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Workload Weights",
          "type": "object"
        }
      },
      "required": [
        "version",
        "binary_check_versions",
        "judge_prompt_versions",
        "physical_test_version",
        "workload_weights",
        "promotion_limits",
        "coverage_floors"
      ],
      "title": "EvaluatorBundle",
      "type": "object"
    },
    "HardwareRequest": {
      "additionalProperties": false,
      "properties": {
        "allow_substitution": {
          "const": false,
          "default": false,
          "title": "Allow Substitution",
          "type": "boolean"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "gpu": {
          "enum": [
            "H100",
            "L40S",
            "B200"
          ],
          "title": "Gpu",
          "type": "string"
        },
        "memory_gib_minimum": {
          "minimum": 1,
          "title": "Memory Gib Minimum",
          "type": "integer"
        },
        "provider": {
          "const": "modal",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "gpu",
        "count",
        "memory_gib_minimum"
      ],
      "title": "HardwareRequest",
      "type": "object"
    },
    "HumanApproval": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ssh-ed25519",
          "default": "ssh-ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Hash",
          "type": "string"
        },
        "public_key": {
          "title": "Public Key",
          "type": "string"
        },
        "signature": {
          "title": "Signature",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer": {
          "title": "Signer",
          "type": "string"
        }
      },
      "required": [
        "payload_hash",
        "signature",
        "public_key",
        "signer",
        "signed_at"
      ],
      "title": "HumanApproval",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "chat_template_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Chat Template Hash",
          "type": "string"
        },
        "file_hashes": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minProperties": 1,
          "title": "File Hashes",
          "type": "object"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "precision": {
          "title": "Precision",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "tokenizer_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tokenizer Hash",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision",
        "file_hashes",
        "tokenizer_hash",
        "chat_template_hash",
        "precision",
        "license"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "ObservedHardware": {
      "additionalProperties": false,
      "properties": {
        "clock_policy": {
          "title": "Clock Policy",
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "cuda": {
          "title": "Cuda",
          "type": "string"
        },
        "driver": {
          "title": "Driver",
          "type": "string"
        },
        "gpu_uuids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Gpu Uuids",
          "type": "array"
        },
        "provider": {
          "const": "modal",
          "title": "Provider",
          "type": "string"
        },
        "sku": {
          "title": "Sku",
          "type": "string"
        },
        "topology_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Topology Hash",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "sku",
        "count",
        "gpu_uuids",
        "topology_hash",
        "driver",
        "cuda",
        "clock_policy"
      ],
      "title": "ObservedHardware",
      "type": "object"
    },
    "PartitionMembership": {
      "additionalProperties": false,
      "properties": {
        "build_report": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "group_assignment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Group Assignment Hash",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/DataPartition"
        },
        "ordered_row_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Ordered Row Ids",
          "type": "array"
        },
        "ordered_row_ids_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ordered Row Ids Hash",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "name",
        "ordered_row_ids",
        "ordered_row_ids_hash",
        "count",
        "source_revision",
        "group_assignment_hash",
        "build_report"
      ],
      "title": "PartitionMembership",
      "type": "object"
    },
    "PromotionLimits": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_resamples": {
          "default": 10000,
          "minimum": 100,
          "title": "Bootstrap Resamples",
          "type": "integer"
        },
        "bootstrap_seed": {
          "default": 20260812,
          "title": "Bootstrap Seed",
          "type": "integer"
        },
        "cold_loads_required": {
          "default": 3,
          "minimum": 1,
          "title": "Cold Loads Required",
          "type": "integer"
        },
        "matched_requests_per_arm": {
          "default": 256,
          "minimum": 1,
          "title": "Matched Requests Per Arm",
          "type": "integer"
        },
        "output_rate_lcb_minimum": {
          "default": 0.03,
          "title": "Output Rate Lcb Minimum",
          "type": "number"
        },
        "p95_latency_upper_regression_maximum": {
          "default": 0.01,
          "title": "P95 Latency Upper Regression Maximum",
          "type": "number"
        },
        "p99_latency_upper_regression_maximum": {
          "default": 0.02,
          "title": "P99 Latency Upper Regression Maximum",
          "type": "number"
        },
        "required_concurrencies": {
          "default": [
            1,
            4
          ],
          "items": {
            "type": "integer"
          },
          "title": "Required Concurrencies",
          "type": "array"
        }
      },
      "title": "PromotionLimits",
      "type": "object"
    },
    "RuntimeRef": {
      "additionalProperties": false,
      "properties": {
        "cuda": {
          "title": "Cuda",
          "type": "string"
        },
        "driver": {
          "title": "Driver",
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "hardware": {
          "$ref": "#/$defs/HardwareRequest"
        },
        "image_digest": {
          "title": "Image Digest",
          "type": "string"
        },
        "kernel_revisions": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "title": "Kernel Revisions",
          "type": "object"
        },
        "observed_hardware": {
          "$ref": "#/$defs/ObservedHardware"
        },
        "packages": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Packages",
          "type": "object"
        },
        "python": {
          "title": "Python",
          "type": "string"
        },
        "sglang_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Sglang Revision",
          "type": "string"
        },
        "specforge_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Specforge Revision",
          "type": "string"
        }
      },
      "required": [
        "image_digest",
        "python",
        "packages",
        "cuda",
        "driver",
        "sglang_revision",
        "specforge_revision",
        "kernel_revisions",
        "environment",
        "hardware",
        "observed_hardware"
      ],
      "title": "RuntimeRef",
      "type": "object"
    },
    "SealedSourceRef": {
      "additionalProperties": false,
      "properties": {
        "manifest_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Hash",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision",
        "manifest_hash"
      ],
      "title": "SealedSourceRef",
      "type": "object"
    },
    "StopRules": {
      "additionalProperties": false,
      "properties": {
        "maximum_updates": {
          "minimum": 1,
          "title": "Maximum Updates",
          "type": "integer"
        },
        "stop_on_artifact_failure": {
          "default": true,
          "title": "Stop On Artifact Failure",
          "type": "boolean"
        },
        "stop_on_missing_observability": {
          "default": true,
          "title": "Stop On Missing Observability",
          "type": "boolean"
        },
        "stop_on_parity_mismatch": {
          "default": true,
          "title": "Stop On Parity Mismatch",
          "type": "boolean"
        }
      },
      "required": [
        "maximum_updates"
      ],
      "title": "StopRules",
      "type": "object"
    },
    "TrainingRule": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "learning_rate": {
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "type": "number"
        },
        "loss_selection": {
          "const": "all_positions",
          "default": "all_positions",
          "title": "Loss Selection",
          "type": "string"
        },
        "maximum_policy_lag": {
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Policy Lag",
          "type": "integer"
        },
        "mode": {
          "const": "online_dflash",
          "title": "Mode",
          "type": "string"
        },
        "trainer": {
          "const": "specforge",
          "title": "Trainer",
          "type": "string"
        },
        "update_every_traces": {
          "minimum": 1,
          "title": "Update Every Traces",
          "type": "integer"
        }
      },
      "required": [
        "trainer",
        "mode",
        "learning_rate",
        "batch_size",
        "update_every_traces",
        "maximum_policy_lag"
      ],
      "title": "TrainingRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/DataManifest"
    },
    "drafter": {
      "$ref": "#/$defs/ModelRef"
    },
    "evaluator": {
      "$ref": "#/$defs/EvaluatorBundle"
    },
    "initial_mode": {
      "const": "off",
      "default": "off",
      "title": "Initial Mode",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeRef"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "seeds": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Seeds",
      "type": "object"
    },
    "stop_rules": {
      "$ref": "#/$defs/StopRules"
    },
    "target": {
      "$ref": "#/$defs/ModelRef"
    },
    "training": {
      "$ref": "#/$defs/TrainingRule"
    }
  },
  "required": [
    "schema_version",
    "name",
    "target",
    "drafter",
    "training",
    "runtime",
    "data",
    "evaluator",
    "seeds",
    "stop_rules"
  ],
  "title": "ExperimentSpec",
  "type": "object"
}
