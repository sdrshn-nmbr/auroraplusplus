{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "storage_path": {
          "title": "Storage Path",
          "type": "string"
        },
        "validation_result": {
          "enum": [
            "pending",
            "valid",
            "invalid"
          ],
          "title": "Validation Result",
          "type": "string"
        }
      },
      "required": [
        "content_hash",
        "size",
        "storage_path",
        "producer",
        "validation_result"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvidenceLevel": {
      "enum": [
        "code-exists",
        "local-test",
        "deterministic-simulation",
        "real-process",
        "physical-gpu",
        "always-running",
        "automatic-promotion-rollback"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "OracleResult": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "failures": {
          "items": {
            "type": "string"
          },
          "title": "Failures",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "passed",
        "version",
        "evidence",
        "failures"
      ],
      "title": "OracleResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Id",
      "type": "string"
    },
    "challenger_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Challenger Id",
      "type": "string"
    },
    "correctness": {
      "$ref": "#/$defs/OracleResult"
    },
    "environment_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Identity",
      "type": "string"
    },
    "evidence_level": {
      "$ref": "#/$defs/EvidenceLevel"
    },
    "health": {
      "$ref": "#/$defs/OracleResult"
    },
    "lossless": {
      "$ref": "#/$defs/OracleResult"
    },
    "performance": {
      "$ref": "#/$defs/OracleResult"
    },
    "profiled": {
      "title": "Profiled",
      "type": "boolean"
    },
    "report_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Id",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "baseline_id",
    "challenger_id",
    "correctness",
    "lossless",
    "performance",
    "health",
    "environment_identity",
    "profiled",
    "evidence_level"
  ],
  "title": "PhysicalEvalReport",
  "type": "object"
}
