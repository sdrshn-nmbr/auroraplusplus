{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "storage_path": {
          "title": "Storage Path",
          "type": "string"
        },
        "validation_result": {
          "enum": [
            "pending",
            "valid",
            "invalid"
          ],
          "title": "Validation Result",
          "type": "string"
        }
      },
      "required": [
        "content_hash",
        "size",
        "storage_path",
        "producer",
        "validation_result"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "effective_configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Effective Configuration Hash",
      "type": "string"
    },
    "loader_verified": {
      "title": "Loader Verified",
      "type": "boolean"
    },
    "optimizer": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "parent_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Parent Id",
      "type": "string"
    },
    "random_state": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "training_cursor": {
      "title": "Training Cursor",
      "type": "string"
    },
    "weights": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Weights",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "parent_id",
    "optimizer",
    "random_state",
    "training_cursor",
    "weights",
    "effective_configuration_hash",
    "loader_verified"
  ],
  "title": "CandidateCheckpoint",
  "type": "object"
}
