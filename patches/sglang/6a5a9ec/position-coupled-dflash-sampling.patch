+def compute_dflash_position_coupled_drafts_and_bonus(
+    *,
+    candidates: torch.Tensor,
+    next_token_logits: torch.Tensor,
+    sampling_info: Any,
+    positions: torch.Tensor,
+    max_top_k: Optional[int] = None,
+    uniform_top_k_value: Optional[int] = None,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """Use the target sampler's position-keyed decision for DFlash verification."""
+    sampling_seed = getattr(sampling_info, "sampling_seed", None)
+    if sampling_seed is None:
+        raise ValueError("position-coupled DFlash sampling requires sampling_seed")
+
+    bs, draft_token_num = candidates.shape
+    if positions.shape != candidates.shape:
+        raise ValueError(
+            "DFlash sampling positions must match candidates, "
+            f"got positions={tuple(positions.shape)} candidates={tuple(candidates.shape)}"
+        )
+    target_probs = build_dflash_verify_target_probs(
+        next_token_logits=next_token_logits,
+        sampling_info=sampling_info,
+        draft_token_num=draft_token_num,
+        bs=bs,
+        max_top_k=max_top_k,
+        uniform_top_k_value=uniform_top_k_value,
+    ).view(bs * draft_token_num, -1)
+    row_count = bs * draft_token_num
+    target_predict = top_k_top_p_min_p_sampling_from_probs_torch(
+        target_probs,
+        torch.full(
+            (row_count,),
+            target_probs.shape[-1],
+            dtype=torch.int32,
+            device=target_probs.device,
+        ),
+        torch.ones(row_count, dtype=torch.float32, device=target_probs.device),
+        torch.zeros(row_count, dtype=torch.float32, device=target_probs.device),
+        False,
+        torch.repeat_interleave(sampling_seed, draft_token_num, dim=0),
+        positions.reshape(-1),
+    ).view(bs, draft_token_num)
+    return compute_dflash_correct_drafts_and_bonus(
+        candidates=candidates,
+        target_predict=target_predict,
+    )
+
+
