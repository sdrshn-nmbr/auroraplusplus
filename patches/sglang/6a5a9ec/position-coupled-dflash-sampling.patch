+class TestPositionCoupledSampling(CustomTestCase):
+    def test_dflash_reuses_target_token_decisions(self):
+        from sglang.srt.layers.sampler import (
+            top_k_top_p_min_p_sampling_from_probs_torch,
+        )
+        from sglang.srt.speculative.dflash_utils import (
+            compute_dflash_position_coupled_drafts_and_bonus,
+        )
+
+        batch_size, block_size, vocab_size = 2, 4, 32
+        generator = torch.Generator().manual_seed(7)
+        logits = torch.randn(
+            batch_size * block_size,
+            vocab_size,
+            generator=generator,
+            dtype=torch.float32,
+        )
+        seeds = torch.tensor([17, 42], dtype=torch.int64)
+        positions = torch.tensor([[10, 11, 12, 13], [21, 22, 23, 24]])
+        sampling_info = SimpleNamespace(
+            sampling_seed=seeds,
+            temperatures=torch.ones(batch_size, 1),
+            top_ks=torch.full((batch_size,), vocab_size, dtype=torch.int32),
+            top_ps=torch.ones(batch_size),
+            need_top_k_sampling=False,
+            need_top_p_sampling=False,
+        )
+        probabilities = torch.softmax(logits, dim=-1)
+        expected = top_k_top_p_min_p_sampling_from_probs_torch(
+            probabilities,
+            torch.full(
+                (batch_size * block_size,), vocab_size, dtype=torch.int32
+            ),
+            torch.ones(batch_size * block_size),
+            torch.zeros(batch_size * block_size),
+            False,
+            torch.repeat_interleave(seeds, block_size),
+            positions.reshape(-1),
+        ).view(batch_size, block_size)
+        candidates = torch.zeros(batch_size, block_size, dtype=torch.int64)
+        candidates[:, 1:].copy_(expected[:, :-1])
+
+        accepted, bonus = compute_dflash_position_coupled_drafts_and_bonus(
+            candidates=candidates,
+            next_token_logits=logits,
+            sampling_info=sampling_info,
+            positions=positions,
+        )
+
+        torch.testing.assert_close(
+            accepted,
+            torch.full((batch_size,), block_size - 1, dtype=torch.int32),
+        )
+        torch.testing.assert_close(bonus, expected[:, -1].to(torch.int64))
+
+
